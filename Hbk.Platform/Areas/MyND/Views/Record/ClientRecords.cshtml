@model Hbk.Models.View.MyND.ClientRecords
@using Hbk.Common.Helpers
@{
    ViewBag.Title = $"{Model.ClientName}'s Records";
    ViewBag.Modules = "clientrecords.js";
    ViewBag.CurrentNav = "ClientRecord";
    ViewBag.css = "clientrecord.css";
    Layout = "_MyND";
}

<h2>@Model.ClientName's Records</h2>
<div id="clientRecordWrap">
@if(Model.ClientRecordList.Count > 0) {
    @foreach (var record in Model.ClientRecordList)
    {
        <div class="clientRecordItem">
            <a asp-area="MyND" asp-controller="Record" asp-action="ClientRecord" asp-route-recordId="@record.Id">@record.Title</a>
            <span><strong>Created</strong><br /><time datetime="@record.Date.ToString("s")">@record.DisplayDate</time></span>
            <span><strong>Visibility</strong><br />@record.Visibility.GetDisplayName()</span>
            <span>@(record.IsPriority ? "Priority" : "")</span>
        </div>
    }
}
else
{
    <div class="clientRecordItem">No records currently exist for @Model.ClientName.</div>
}
    <div id="clientRecordStuffing"></div>
</div>
<input type="submit" value="Add New" id="btnAdd" data-clientId="@Model.ClientId" />
