@{
    ViewData["Title"] = "Clinical practice management";
}

<div id="homeContainer" class="home-overview">
    <div class="home-overview__intro">
        <h1 class="no-margins mci-body-font">HBK.Platform</h1>
        <p class="home-overview__lead">All-in-one practice management for independent practitioners, clients, and clinics. 100% open-source.</p>
    </div>

    <section class="home-overview__section" aria-labelledby="platform-features">
        <div class="home-overview__section-heading">
            <h2 id="platform-features">Built for day-to-day practice operations</h2>
        </div>
        <div class="home-overview__grid">
            <article class="home-overview__feature">
                <h3>Client and practitioner management</h3>
                <p>Role-based workspaces for client details, practitioner records, and clinic administration.</p>
            </article>
            <article class="home-overview__feature">
                <h3>Appointments and availability</h3>
                <p>Treatment scheduling, booking confirmation, cancellations, and weekly availability management.</p>
            </article>
            <article class="home-overview__feature">
                <h3>Clinic room workflow</h3>
                <p>Room configuration, availability, reservations, and the supporting clinic management flows.</p>
            </article>
        </div>
    </section>

    <aside id="searchBody" class="home-overview__access" aria-label="Access to the demonstration">
        <h2>Access to the demonstration</h2>
        <p>Independent practitioners can <a asp-area="Account" asp-page="/Register">create a practitioner account and start a new practice</a>.</p>
        <p>Clinic managers can <a asp-area="Account" asp-page="/RegisterClinic">create a clinic account</a>.</p>
        <p>Practitioners, clients, and clinic managers may <a asp-area="Account" asp-page="/Login">sign in</a> with an existing account.</p>
    </aside>
</div>
